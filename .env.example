# Copy to .env and run uvicorn with --env-file .env (or set OS env vars).
# Leave CHURCH_PASSWORD empty for localhost use without login.
CHURCH_PASSWORD=
CHURCH_SESSION_SECRET=
CHURCH_BIND_ADDRESS=127.0.0.1

# Optional laptop tuning. 0 means FFmpeg chooses its own thread count.
DEFAULT_WHISPER_MODEL=large-v3-turbo
WHISPER_CPU_THREADS=4
WHISPER_BATCH_SIZE=8
FFMPEG_THREADS=0
FFMPEG_FILTER_THREADS=0
FFMPEG_HWACCEL=auto
RENDER_WORKERS=1
TRIM_WORKERS=2
# FFMPEG_PATH=/absolute/path/to/ffmpeg
# FFPROBE_PATH=/absolute/path/to/ffprobe

# Configure a provider key AND its model ID to enable direct generation.
# Keys stay on the server. No direct API call is made by Copy Prompt.
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Alternatively configure LLM_PROVIDER + LLM_MODEL for one provider.
LLM_PROVIDER=
LLM_MODEL=

# --- Quy tắc đặt tên file & Đồng bộ Google Drive ---
# Quy tắc tên file: <năm><tháng><ngày>_<chủ đề>_<diễn giả> <phiên bản>
# Ví dụ: 20261021_Gió tầng nào gặp mây tầng đó_Hoàng Nam Tiến v1.mp4
DEFAULT_SPEAKER_NAME=Hội Thánh
FILENAME_ASCII_SLUG=false

# Bật/tắt đồng bộ Google Drive (true/false)
GDRIVE_ENABLED=false
# Tự động đẩy file (.mp4 + .srt) lên Google Drive ngay sau khi xuất xong
GDRIVE_AUTO_SYNC=true
# Tự động xóa file video .mp4 trên ổ cứng máy sau khi đã đẩy lên Google Drive để tiết kiệm bộ nhớ
GDRIVE_DELETE_LOCAL_AFTER_SYNC=true
# Tự động gom vào thư mục con theo tháng YYYY-MM trên Google Drive
GDRIVE_SUBFOLDER_BY_MONTH=true

# [Cách 1] Đồng bộ qua Google Drive REST API v3 (OAuth2 Refresh Token):
# Điền ID thư mục hoặc dán nguyên link https://drive.google.com/drive/folders/<ID>
GDRIVE_FOLDER_ID=
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
GDRIVE_REFRESH_TOKEN=

# [Cách 2] Hoặc đồng bộ qua thư mục Google Drive for Desktop trên máy (VD: G:\My Drive\ChurchVideo):
GDRIVE_LOCAL_SYNC_DIR=
